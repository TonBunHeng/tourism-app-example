<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartTourismApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core Theme Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>

        <!-- Component Defaults -->
        <item name="textInputStyle">@style/AppTextInput.Layout</item>
        <item name="materialButtonStyle">@style/AppButton.Primary</item>
        <item name="materialAlertDialogTheme">@style/AppMaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/AppMaterialAlertDialog</item>
    </style>

    <style name="Theme.SmartTourismApp" parent="Base.Theme.SmartTourismApp" />

    <!-- Material AlertDialog Theme Overlay -->
    <style name="AppMaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/AppDialogShapeAppearance</item>
        <item name="backgroundTint">@color/background</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButton.Negative</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButton.Positive</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogButton.Negative</item>
    </style>

    <style name="AppDialogShapeAppearance" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="AppDialogButton.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppDialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#0F4C81</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>