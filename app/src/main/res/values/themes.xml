<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartTourismApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SmartTourismApp" parent="Base.Theme.SmartTourismApp" />

    <!-- Splash screen -->
    <style name="Theme.SmartTourismApp.Splash" parent="Theme.SplashScreen">

        <!-- Backgroundcolor -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- App Icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_launcher</item>

        <!-- Theme after splash -->
        <item name="postSplashScreenTheme">@style/Theme.SmartTourismApp</item>
    </style>
</resources>