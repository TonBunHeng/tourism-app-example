<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 1. Filled Button (Primary Action) -->
    <style name="Primary.Button" parent="Widget.Material3.Button">
        <!-- Size -->
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">18sp</item>

        <!-- Color -->
        <item name="backgroundTint">@color/primary</item>

        <!-- Style -->
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 2. Outlined Button (Secondary Action - Border) -->
    <style name="Secondary.Button" parent="Widget.Material3.Button.OutlinedButton">
        <!-- Size -->
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">18sp</item>
        <item name="strokeWidth">2dp</item>

        <!-- Color -->
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>

        <!-- Style -->
        <item name="android:textStyle">bold</item>

    </style>

    <!-- 3. Text Button (Tertiary Action - No Background & Border) -->
    <style name="Tertiary.Button" parent="Widget.Material3.Button">
        <item name="color">@color/primary</item>
    </style>
</resources>