<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivBusinessIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_business"
        app:tint="@color/primary"
        android:contentDescription="Business Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvSelectorBusinessName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Angkor Sunrise Travels"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvSelectorBusinessCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tour Agency • Siem Reap"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectorStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verified"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="#DCFCE7"
        android:textColor="#166534"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/ivSelectedCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check"
        app:tint="@color/primary"
        android:visibility="gone"
        android:contentDescription="Active Business Selected" />

</LinearLayout>

