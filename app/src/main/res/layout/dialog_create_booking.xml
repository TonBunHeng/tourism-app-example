<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvBookingDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reserve Visit"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Select your visit date, time slot, and guest party."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Date input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingDate"
        style="@style/AppTextInput.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Visit Date (YYYY-MM-DD)*"
        app:startIconDrawable="@drawable/ic_calendar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="date" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Time input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingTime"
        style="@style/AppTextInput.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Arrival Time (e.g. 09:00 AM)*">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookingTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="09:00 AM" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Number of guests -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingGuests"
        style="@style/AppTextInput.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Number of Guests*">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookingGuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Special Requests -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingRequests"
        style="@style/AppTextInput.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Special Requests / Notes (optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookingRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

