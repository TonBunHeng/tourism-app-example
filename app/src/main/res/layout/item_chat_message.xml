<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- AI Message Container -->
    <LinearLayout
        android:id="@+id/layout_ai_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|top"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/placeholder_avatar"
            android:contentDescription="@string/ai_banner_title"
            android:padding="6dp"
            android:src="@drawable/ic_sparkles"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/chat_ai_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_ai_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="280dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/chat_ai_text"
                    android:textSize="14sp"
                    tools:text="Hello! I am your Angkor AI Assistant. How can I help you plan your journey in Siem Reap today?" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_ai_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/outline"
                android:textSize="11sp"
                tools:text="Just now" />

        </LinearLayout>

    </LinearLayout>

    <!-- User Message Container -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/chat_user_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_user_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/chat_user_text"
                android:textSize="14sp"
                tools:text="Can you recommend a 3-day itinerary?" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_user_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/outline"
            android:textSize="11sp"
            tools:text="Just now" />

    </LinearLayout>

</LinearLayout>