<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartTourismApp" >
        <activity
            android:name=".ui.onboarding.OnBoardingActivity"
            android:exported="false" />
        <!-- Splash Screen -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartTourismApp.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Traveller Screen -->
        <activity
            android:name=".ui.traveller.TravellerMainActivity"
            android:exported="false" /> <!-- Business Screen -->
        <activity
            android:name=".ui.business.BusinessMainActivity"
            android:exported="false" /> <!-- Register Screen -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" /> <!-- Login Screen -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" /> <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" >

            <!-- <intent-filter> -->
            <!-- <action android:name="android.intent.action.MAIN" /> -->


            <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            <!-- </intent-filter> -->

        </activity>
    </application>

</manifest>