<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <!-- Internet & Network permissions for backend REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TourismApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SmartTourismApp" >

        <!-- Onboarding Screen -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- Splash Screen -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartTourismApp.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Traveller Screen -->
        <activity
            android:name=".ui.traveller.TravellerMainActivity"
            android:exported="false" />

        <!-- Place Detail Screen -->
        <activity
            android:name=".ui.traveller.PlaceDetailActivity"
            android:exported="false" />

        <!-- Businesses List Screen -->
        <activity
            android:name=".ui.business.BusinessesActivity"
            android:exported="false" />

        <!-- Business Detail Screen -->
        <activity
            android:name=".ui.business.BusinessDetailActivity"
            android:exported="false" />

        <!-- Booking Detail Screen -->
        <activity
            android:name=".ui.booking.BookingDetailActivity"
            android:exported="false" />

        <!-- Categories Browsing Screen -->
        <activity
            android:name=".ui.category.CategoriesActivity"
            android:exported="false" />

        <!-- Provinces Browsing Screen -->
        <activity
            android:name=".ui.province.ProvincesActivity"
            android:exported="false" />

        <!-- Notifications Screen -->
        <activity
            android:name=".ui.notification.NotificationsActivity"
            android:exported="false" />

        <!-- Support & Emergency Screen -->
        <activity
            android:name=".ui.support.SupportActivity"
            android:exported="false" />

        <!-- AI Assistant Screen -->
        <activity
            android:name=".ui.ai.AIChatActivity"
            android:exported="false" />

        <!-- Business Screen -->
        <activity
            android:name=".ui.business.BusinessMainActivity"
            android:exported="false" />

        <!-- Register Screen -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Sign In Screen -->
        <activity
            android:name=".ui.auth.SignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" >
        </activity>

    </application>

</manifest>